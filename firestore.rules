rules_version = '2';

// Players sign in with Google; their Firebase Auth uid is their playerId.
// Room creation and dice rolls go through the Render server (Admin SDK),
// which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    // Ludo rooms are written only by the server, which validates every move.
    function isLudo(data) {
      return data.get('game', '') == 'ludo';
    }

    match /rooms/{roomId} {
      allow read: if request.auth != null;
      // Snakes & Ladders: joining, leaving, starting and colour changes are
      // client transactions. A player may only touch their own entry or the
      // shared game fields.
      allow update: if request.auth != null
        && !isLudo(resource.data)
        && !isLudo(request.resource.data)
        && (request.auth.uid in resource.data.players
            || request.auth.uid in request.resource.data.players);
      allow delete: if request.auth != null
        && !isLudo(resource.data)
        && resource.data.players.size() <= 1
        && request.auth.uid in resource.data.players;

      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.playerId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && (!('image' in request.resource.data)
              || (request.resource.data.image is string
                  && request.resource.data.image.size() <= 450000
                  && request.resource.data.image.matches('^data:image/jpeg;base64,.*')))
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.players;
        // Players can delete their own messages
        allow delete: if request.auth != null && resource.data.playerId == request.auth.uid;
      }
    }
  }
}
